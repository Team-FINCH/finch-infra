# infra/.env 로 복사해서 서버에만 둔다. .env 는 절대 커밋하지 않는다.
# 실제 값은 Jenkins Credentials 에 등록해 두고 배포 시점에 이 파일로 주입한다 (결정서 참고).

TZ=Asia/Seoul

# ── backend DB (postgres:17) ─────────────────────────────
BACKEND_DB_USER=app
BACKEND_DB_PASSWORD=change-me
BACKEND_DB_NAME=app

# ── backend 인증 (application.yaml 이 기본값 없이 요구한다) ──
# JWT_SECRET: HS256 서명 키. UTF-8 32바이트 미만이면 기동 시 WeakKeyException 으로 거부된다.
# KAKAO_CLIENT_ID: 카카오 개발자 콘솔의 REST API 키. JavaScript 키가 아니다.
#   백엔드 environment 와 프런트 build arg(VITE_KAKAO_REST_API_KEY)가 이 한 값을 함께 쓴다.
#   공개 client_id 라 번들에 실려도 되는 값이다 — BACKEND_ 접두사를 붙이지 않는 이유다.
# KAKAO_CLIENT_SECRET: 콘솔에서 Client Secret 을 켠 앱만 값이 있다. 안 켰으면 빈 값으로 둔다.
#   빈 값이면 토큰 교환 폼에서 client_secret 파라미터 자체가 빠진다.
#   우리 앱은 켜져 있다 — 빈 값으로 두면 토큰 교환이 KOE010 으로 실패한다 (2026-09-03 실측).
BACKEND_JWT_SECRET=change-me-at-least-32-bytes-long
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=

# ── 카카오페이 결제 (application.yaml finch.deposit.kakaopay) ──
# KAKAOPAY_SECRET_KEY: developers.kakaopay.com 의 dev/prod Secret Key. 로그인용 카카오 키와 다른 값이다.
#   운영에서는 이 파일이 아니라 Jenkins Credentials 의 finch-kakaopay-secret (Secret text) 에 두고,
#   Jenkinsfile 의 '비밀값 주입' 이 배포 시점에 이 파일로 한 줄 덧붙인다. 로컬에서는 여기에 적는다.
#
# 없으면 기동이 막히지 않고 결제 시점에 실패한다 (2026-09-07 실측, FINCH-159).
#   DepositProperties 가 @ConfigurationProperties record 라 해석 안 되는 placeholder 를
#   예외 대신 문자열로 남기고, 그 문자열이 Authorization 헤더에 그대로 실린다.
#   그래서 compose 쪽에서 :? 로 막는다 — 애플리케이션은 이 누락을 잡아주지 않는다.
KAKAOPAY_SECRET_KEY=change-me

# ── 외부 주소 (선택. 적지 않아도 된다) ───────────────────
# compose 가 운영값을 기본값으로 들고 있으므로 이 파일에 없어도 동작한다.
# 다른 도메인으로 띄울 때만 여기에 적어 덮어쓴다.
#
# FINCH_PUBLIC_BASE_URL: 우리 서버의 외부 주소. 카카오가 사용자 브라우저를 되돌려 보낼
#   승인 콜백 URL 을 이 값으로 만든다. 틀리면 결제 승인 후 복귀가 깨진다.
# FINCH_FRONT_BASE_URL: 프론트 주소. 배포는 nginx 가 같은 오리진으로 붙이므로 위와 같은 값이다.
#
# 비밀값이 아니라 Jenkins Credentials 가 아닌 compose 에 기본값으로 둔다. 도메인은
# nginx.conf, Jenkinsfile, infra/README.md 에 이미 평문으로 있다.
# 값이 없을 때 :? 로 기동을 막지 않는 이유도 이것이다 — 기본값이 있으면 누락이 성립하지 않는다.
# (2026-09-07 FINCH-151: 계약만 application.yaml 에 있고 주입이 없어
#  운영이 localhost 기본값으로 떠 있었다. GitLab 이슈 #35 로 발견)
#
# FINCH_AI_BASE_URL: backend 가 부르는 AI 서버 주소. 배포는 compose 서비스 이름(http://ai:8000),
#   로컬은 uvicorn 기본 포트(http://localhost:8000). 경로 접두사 /api/ai/v1 은 코드가 붙인다.
#   주입하지 않으면 backend 컨테이너가 자기 자신의 8000 을 불러 중계가 전부 실패한다
#   (2026-09-08 실측, FINCH-171).
#
# FINCH_PUBLIC_BASE_URL=https://finchapp.org
# FINCH_FRONT_BASE_URL=https://finchapp.org
# FINCH_AI_BASE_URL=http://ai:8000

# ── ai DB (pgvector/pgvector:pg17) ───────────────────────
# ai/compose.yaml(로컬 개발용)과 같은 계정 구성. 서버에서는 비밀번호를 반드시 바꾼다.
AI_DB_USER=ai_invest
AI_DB_PASSWORD=change-me
AI_DB_NAME=ai_invest

# ── ai 외부 API 키 ───────────────────────────────────────
# 이 파일이 아니라 infra/ai.env 에 둔다. ai/.env.example 을 복사해서 작성할 것.
# (DATABASE_URL·BACKEND_BASE_URL 은 compose 가 컨테이너 주소로 덮어쓰므로 비워둬도 된다)

# ── 관측 스택 (docker-compose.observability.yml) ─────────
# 값을 비우면 Grafana 가 기동을 거부한다. 기본 비밀번호로 뜨는 사고를 막기 위한 의도적 설계.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
