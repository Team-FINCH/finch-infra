// Alloy: 로그를 읽어 Loki 로 보낸다. 파이프라인이 둘이다.
//
//   1) 클러스터 안  파드 로그      /var/log/pods 파일을 읽는다
//   2) 클러스터 밖  도커 컨테이너   도커 소켓 API 로 읽는다 (jenkins, gitlab-runner)
//
// 왜 하나로 못 하는가 — 실측으로 알아낸 것이다
//   k3s 런타임이 Docker 라(FINCH-39) 파드 컨테이너도 같은 도커 데몬 위에 있고,
//   `docker ps` 에 34개가 보인다. 그래서 discovery.docker 하나로 양쪽을 다 볼 수
//   있다고 판단했는데 **틀렸다.**
//
//   discovery.docker 는 (컨테이너, 네트워크) 쌍으로 대상을 만든다. 파드 컨테이너는
//   pause 컨테이너의 네트워크 이름공간을 공유하므로 자기 네트워크가 없다.
//
//     파드 컨테이너    NetworkMode=container:<sandbox>  Networks=0  Ports=map[]
//     compose 컨테이너 NetworkMode=finch_default         Networks=1  Ports=8080/tcp
//
//   그래서 **파드는 대상 목록에 아예 오르지 않는다.** 발견된 대상 24개 중
//   쿠버네티스 라벨을 가진 것이 0개였다. `docker ps` 로는 보이는데
//   discovery.docker 로는 안 보인다 — 확인한 도구와 쓰는 도구가 달랐다.

// ── 1) 파드 로그 ────────────────────────────────────────────
//
// DaemonSet 이므로 이 노드의 파드만 봐야 한다. 필터를 안 걸면 파드마다 모든
// 노드의 Alloy 가 파일을 찾고, 없는 파일이라 조용히 아무것도 수집하지 않는다.
// 단일 노드에서는 결과가 같아 문제가 드러나지 않는다.
discovery.kubernetes "pods" {
  role = "pod"
  selectors {
    role  = "pod"
    field = "spec.nodeName=" + sys.env("NODE_NAME")
  }
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  // 아직 안 뜬 파드는 로그 파일이 없다. 대상으로 두면 file_match 가 계속 헛돈다.
  rule {
    source_labels = ["__meta_kubernetes_pod_phase"]
    regex         = "Pending|Succeeded|Failed"
    action        = "drop"
  }

  // 컨테이너 이름이 서비스 축이다 (backend, ai, frontend).
  // 파드 이름과 달리 배포해도 바뀌지 않는다.
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "service"
  }

  // 어느 레플리카인지. 파드 이름은 배포마다 바뀌어 스트림이 새로 생기는데,
  // 그 비용을 내고 레플리카 단위 조회를 얻는 거래다.
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    target_label = "origin"
    replacement  = "k8s"
  }

  // 수집 경로를 나타낸다. 도커 파이프라인은 job="docker" 다.
  //
  // 파드 로그에도 job="docker" 를 붙이면 기존 대시보드 쿼리가 그대로 동작하지만,
  // **라벨이 거짓이 된다** — 도커 소켓으로 읽은 것이 아니라 파일로 읽은 것이다.
  // 나중에 이 라벨로 수집 경로를 판별하려는 사람이 틀린 답을 얻는다.
  // 라벨을 정직하게 두고 대시보드 쿼리를 고쳤다 (finch-overview.json).
  rule {
    target_label = "job"
    replacement  = "k8s"
  }

  // 기존 대시보드의 로그 패널이 stack 으로 필터한다. 파드에 stack 을 안 붙이면
  // **파드 로그가 그 패널에서 조용히 사라진다.** 그래프가 비는 것이 아니라
  // 로그가 덜 나오는 형태라 알아채기 어렵다.
  rule {
    target_label = "stack"
    replacement  = "finch-k8s"
  }

  // 로그 파일 경로를 조립한다.
  //   /var/log/pods/<namespace>_<pod>_<uid>/<container>/0.log
  // separator 로 uid 와 컨테이너 이름을 이어 $1 에 담고, 앞의 * 가
  // <namespace>_<pod>_ 부분을 대신한다.
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    action        = "replace"
    replacement   = "/var/log/pods/*$1/*.log"
    target_label  = "__path__"
  }
}

local.file_match "pod_logs" {
  path_targets = discovery.relabel.pod_logs.output
}

loki.source.file "pod_logs" {
  targets    = local.file_match.pod_logs.targets
  forward_to = [loki.process.pod_logs.receiver]
}

// /var/log/pods 의 파일은 /var/lib/docker/containers/.../*-json.log 로 가는
// 심볼릭 링크이고, 내용은 도커 JSON 이다.
//
//   {"log":"실제 로그\n","stream":"stdout","time":"2026-09-09T01:45:46Z"}
//
// 벗기지 않으면 Loki 에 이 JSON 껍데기가 그대로 들어가, 로그 본문 검색이
// 껍데기까지 훑고 Grafana 에도 한 줄이 JSON 으로 보인다.
//
// **이 stage 는 런타임 결정에 묶여 있다.** containerd 로 바꾸면 파일 형식이
// CRI 텍스트("<time> <stream> <flag> <message>")가 되므로 `cri` stage 로 바꿔야 한다.
loki.process "pod_logs" {
  stage.docker {}

  forward_to = [loki.write.default.receiver]
}

// ── 2) 클러스터 밖 도커 컨테이너 ────────────────────────────
// jenkins 와 gitlab-runner. 이 둘은 클러스터 안으로 들어오지 않는다
// (FINCH-39 결정). 클러스터 안만 보면 배포 실패를 관측할 수단이 사라진다.
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // 파드 컨테이너가 여기 오르면 위 파이프라인과 겹쳐 **같은 로그가 두 번** 들어간다.
  // 지금은 네트워크가 없어 대상이 되지 않지만 그것에 기대지 않는다 —
  // Alloy 의 디스커버리 동작이 바뀌면 중복이 조용히 생기고, 양이 늘었다는
  // 것만 보인다.
  rule {
    source_labels = ["__meta_docker_container_label_io_kubernetes_docker_type"]
    regex         = ".+"
    action        = "drop"
  }

  // Testcontainers 가 CI 중에 만드는 일회성 컨테이너를 뺀다.
  // 이름이 무작위라(modest_hermann 같은) 빌드마다 새 스트림이 생기고,
  // 색인만 늘리고 조회 가치는 없다. CI 실패는 gitlab-runner 로그로 본다.
  rule {
    source_labels = ["__meta_docker_container_label_org_testcontainers"]
    regex         = ".+"
    action        = "drop"
  }

  // 도커 컨테이너 이름은 "/finch-jenkins" 처럼 앞에 슬래시가 붙는다. 떼어낸다.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  // compose 가 붙여주는 서비스 이름. 컨테이너를 다시 만들어도 유지된다.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "(.+)"
    target_label  = "stack"
  }

  rule {
    target_label = "origin"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { job = "docker" }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    // 같은 네임스페이스의 Service 라 짧은 이름으로 풀린다.
    url = "http://loki:3100/loki/api/v1/push"
  }
  // 지표(Prometheus external_labels)와 같은 값을 써서 로그와 지표를 같은 축으로
  // 필터할 수 있게 맞춘다.
  external_labels = {
    env = "prod",
  }
}
